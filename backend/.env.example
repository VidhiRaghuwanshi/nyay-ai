# Copy this file to .env and replace placeholder values.
# Never commit backend/.env or expose these values in frontend code.

# Google Gemini API
GOOGLE_API_KEY=replace_with_your_google_gemini_api_key
GOOGLE_PROJECT_ID=
GOOGLE_CREDENTIALS_PATH=

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Database (optional for the current prototype)
DATABASE_URL=
MONGODB_URL=mongodb://localhost:27017
DATABASE_BACKEND=mongo
MONGODB_DATABASE=legal_ai
ENABLE_LEGALTECH_PERSISTENCE=False
ENABLE_PRECEDENT_RAG=False
ENABLE_TIME_TRACKING=False
ENABLE_INVOICING=False
GOOGLE_MODEL=gemini-3.8-flash
GOOGLE_EMBEDDING_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=60
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
OCR_PROVIDER=paddleocr
OCR_MAX_PAGES=20
TRANSCRIPTION_PROVIDER=local
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8

DATABASE_BACKEND=mongo
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=legal_ai
ENABLE_LEGALTECH_PERSISTENCE=True
ENABLE_PRECEDENT_RAG=True
ENABLE_TIME_TRACKING=True
ENABLE_INVOICING=True

# Security
# Generate a long random value before using authentication in production.
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REQUIRE_AUTH=False
DEV_ALLOW_INSECURE_TENANT_HEADERS=True
ORGANIZATION_MEMBERSHIP_BACKEND=unconfigured
ENABLE_AUTOMATIC_AUDIT=True
ALLOWED_ORIGINS=["http://localhost:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
